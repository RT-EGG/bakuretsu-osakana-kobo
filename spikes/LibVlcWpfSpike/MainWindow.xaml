<Window x:Class="BakuretsuOsakanaKobo.Spikes.LibVlcWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvs="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="爆裂おさかな工房 - LibVLC技術スパイク"
        Width="1100"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        Background="#171717"
        Foreground="#F5F5F5">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#242424" Foreground="#F5F5F5">
            <MenuItem Header="ファイル">
                <MenuItem Header="開く..." Click="OpenMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="終了" Click="ExitMenuItem_OnClick" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom"
                Padding="12"
                Background="#242424">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayPauseButton"
                        Grid.Row="0"
                        Grid.Column="0"
                        Width="92"
                        Margin="0,0,12,0"
                        Click="PlayPauseButton_OnClick"
                        Content="再生" />

                <Slider x:Name="SeekSlider"
                        Grid.Row="0"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="1"
                        PreviewMouseLeftButtonDown="SeekSlider_OnPreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="SeekSlider_OnPreviewMouseLeftButtonUp" />

                <TextBlock x:Name="TimeText"
                           Grid.Row="0"
                           Grid.Column="2"
                           Width="165"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="00:00:00 / 00:00:00" />

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="0,12,0,0"
                            Orientation="Horizontal">
                    <Button Width="92"
                            Margin="0,0,20,0"
                            Click="RestartButton_OnClick"
                            Content="先頭から" />
                    <TextBlock VerticalAlignment="Center" Text="速度" />
                    <ComboBox x:Name="RateComboBox"
                              Width="90"
                              Margin="8,0,20,0"
                              SelectionChanged="RateComboBox_OnSelectionChanged">
                        <ComboBoxItem Tag="0.25">0.25x</ComboBoxItem>
                        <ComboBoxItem Tag="0.5">0.5x</ComboBoxItem>
                        <ComboBoxItem IsSelected="True" Tag="1.0">1.0x</ComboBoxItem>
                        <ComboBoxItem Tag="1.5">1.5x</ComboBoxItem>
                        <ComboBoxItem Tag="2.0">2.0x</ComboBoxItem>
                    </ComboBox>

                    <TextBlock VerticalAlignment="Center" Text="音量要求" />
                    <Slider x:Name="VolumeSlider"
                            Width="260"
                            Margin="8,0,8,0"
                            Minimum="0"
                            Maximum="500"
                            TickFrequency="25"
                            Value="100"
                            ValueChanged="VolumeSlider_OnValueChanged" />
                    <TextBlock x:Name="VolumeText"
                               Width="190"
                               VerticalAlignment="Center"
                               Text="100%（実値: 未確認）" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <lvs:VideoView x:Name="VideoView">
                <Grid IsHitTestVisible="False">
                    <Border Margin="16"
                            Padding="10,6"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#B0000000"
                            CornerRadius="4">
                        <TextBlock x:Name="OverlayStatusText"
                                   Foreground="White"
                                   Text="ファイルを開いてください" />
                    </Border>
                </Grid>
            </lvs:VideoView>
        </Grid>
    </DockPanel>
</Window>
