<Window x:Class="BakuretsuOsakanaKobo.PlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="プレイリスト — 爆裂おさかな工房"
        Icon="Assets/BakuretsuOsakanaKobo.ico"
        Width="680"
        Height="540"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        PreviewDragOver="Window_OnPreviewDragOver"
        PreviewDrop="Window_OnPreviewDrop"
        AutomationProperties.Name="プレイリスト">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="12,12,12,8" LastChildFill="True">
            <ToggleButton x:Name="LoopToggle"
                          DockPanel.Dock="Right"
                          MinWidth="92"
                          Margin="8,0,0,0"
                          Padding="12,8"
                          Foreground="{StaticResource TextBrush}"
                          Background="{StaticResource PanelRaisedBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          Checked="LoopToggle_OnChanged"
                          Unchecked="LoopToggle_OnChanged"
                          Content="↻  ループ OFF"
                          AutomationProperties.Name="プレイリストをループ" />
            <WrapPanel>
                <Button x:Name="PlayPlaylistButton"
                        MinWidth="78"
                        Style="{StaticResource PlaylistPrimaryButtonStyle}"
                        IsEnabled="False"
                        Click="PlayPlaylistButton_OnClick"
                        Content="▶  再生" />
                <Button x:Name="AddCurrentButton"
                        Margin="8,0,0,0"
                        Style="{StaticResource PlaylistButtonStyle}"
                        IsEnabled="False"
                        Click="AddCurrentButton_OnClick"
                        Content="現在の動画を追加" />
                <Button x:Name="AddFilesButton"
                        Margin="8,0,0,0"
                        Style="{StaticResource PlaylistButtonStyle}"
                        IsEnabled="False"
                        Click="AddFilesButton_OnClick"
                        Content="ファイルを追加…" />
                <Button x:Name="RemoveSelectedButton"
                        Margin="8,0,0,0"
                        Style="{StaticResource PlaylistButtonStyle}"
                        IsEnabled="False"
                        Click="RemoveSelectedButton_OnClick"
                        Content="選択項目を削除" />
            </WrapPanel>
        </DockPanel>

        <Border x:Name="NotificationBar"
                Grid.Row="1"
                Margin="12,0,12,8"
                Padding="10,7"
                Background="#192A38"
                BorderBrush="#41769B"
                BorderThickness="1"
                CornerRadius="5"
                Visibility="Collapsed"
                AutomationProperties.LiveSetting="Polite">
            <TextBlock x:Name="NotificationText"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>

        <Grid Grid.Row="2" Margin="12,0,12,12">
            <ListBox x:Name="PlaylistList"
                     SelectionMode="Extended"
                     AllowDrop="True"
                     Background="{StaticResource PanelBrush}"
                     Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="PlaylistList_OnSelectionChanged"
                     MouseDoubleClick="PlaylistList_OnMouseDoubleClick"
                     PreviewMouseLeftButtonDown="PlaylistList_OnPreviewMouseLeftButtonDown"
                     MouseMove="PlaylistList_OnMouseMove"
                     DragOver="PlaylistList_OnDragOver"
                     Drop="PlaylistList_OnDrop"
                     AutomationProperties.Name="プレイリスト項目">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ItemBorder"
                                Padding="10,8"
                                Background="#131B26"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           Text="{Binding Order}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               Text="{Binding Path}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Border x:Name="CurrentBadge"
                                            Padding="7,3"
                                            Background="#174C69"
                                            CornerRadius="4"
                                            Visibility="Collapsed">
                                        <TextBlock FontSize="11" Foreground="#A9E7FF" Text="再生中" />
                                    </Border>
                                    <Border x:Name="MissingBadge"
                                            Padding="7,3"
                                            Background="#48212A"
                                            CornerRadius="4"
                                            Visibility="Collapsed">
                                        <TextBlock FontSize="11" Foreground="#FFABB4" Text="{Binding StatusText}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.68" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="#24181E" />
                                <Setter TargetName="MissingBadge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasLoadError}" Value="True">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.68" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="#24181E" />
                                <Setter TargetName="MissingBadge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#12334A" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="CurrentBadge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyPlaylistPanel"
                        Width="330"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Text="プレイリストは空です" />
                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextAlignment="Center"
                           Text="ファイルを追加するか、動画をここへドロップしてください。" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
