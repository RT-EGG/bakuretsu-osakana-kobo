<Window x:Class="BakuretsuOsakanaKobo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="爆裂おさかな工房"
        Width="1000"
        Height="650"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="爆裂おさかな工房">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="ファイル(_F)">
                <MenuItem x:Name="OpenVideoMenuItem"
                          Header="開く(_O)..."
                          IsEnabled="False"
                          Click="OpenVideoMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="データフォルダーを開く(_D)" Click="OpenDataFolderMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="終了(_X)" Click="ExitMenuItem_OnClick" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Background="Black">
            <vlc:VideoView x:Name="VideoView"
                           HorizontalContentAlignment="Stretch"
                           VerticalContentAlignment="Stretch">
                <StackPanel x:Name="EmptyStatePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyStateTitleText"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="動画が選択されていません" />
                    <TextBlock x:Name="EmptyStateDescriptionText"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="「ファイル」→「開く」からmp4またはwmvを選択してください" />
                </StackPanel>
            </vlc:VideoView>
        </Grid>

        <Border x:Name="NotificationBorder"
                Grid.Row="2"
                Margin="12"
                Padding="12"
                Background="#2B2026"
                BorderBrush="#FF6B79"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed"
                AutomationProperties.LiveSetting="Assertive">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="NotificationMessageText"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="NotificationActionText"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        Padding="8,4"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="通知を閉じる"
                        Click="DismissNotificationButton_OnClick"
                        Content="閉じる" />
            </Grid>
        </Border>
    </Grid>
</Window>
