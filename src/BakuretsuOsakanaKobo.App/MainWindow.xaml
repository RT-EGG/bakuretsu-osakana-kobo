<Window x:Class="BakuretsuOsakanaKobo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="爆裂おさかな工房"
        Width="1000"
        Height="650"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        PreviewMouseMove="Window_OnPreviewMouseMove"
        PreviewDragEnter="Window_OnPreviewDragEnter"
        PreviewDragOver="Window_OnPreviewDragOver"
        PreviewDragLeave="Window_OnPreviewDragLeave"
        PreviewDrop="Window_OnPreviewDrop"
        AutomationProperties.Name="爆裂おさかな工房">
    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu x:Name="MainMenu" Grid.Row="0">
            <MenuItem Header="ファイル(_F)">
                <MenuItem x:Name="OpenVideoMenuItem"
                          Header="開く(_O)..."
                          IsEnabled="False"
                          Click="OpenVideoMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="データフォルダーを開く(_D)" Click="OpenDataFolderMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="終了(_X)" Click="ExitMenuItem_OnClick" />
            </MenuItem>
        </Menu>

        <Grid x:Name="VideoSurface"
              Grid.Row="1"
              Background="Black">
            <vlc:VideoView x:Name="VideoView"
                           HorizontalContentAlignment="Stretch"
                           VerticalContentAlignment="Stretch">
                <Grid x:Name="VideoInteractionSurface"
                      Background="#01000000"
                      Focusable="True"
                      AllowDrop="True"
                      PreviewKeyDown="Window_OnPreviewKeyDown"
                      PreviewMouseWheel="VideoSurface_OnPreviewMouseWheel"
                      PreviewMouseLeftButtonDown="VideoSurface_OnPreviewMouseLeftButtonDown"
                      PreviewMouseLeftButtonUp="VideoSurface_OnPreviewMouseLeftButtonUp"
                      PreviewMouseMove="VideoSurface_OnPreviewMouseMove"
                      LostMouseCapture="VideoSurface_OnLostMouseCapture"
                      PreviewDragEnter="Window_OnPreviewDragEnter"
                      PreviewDragOver="Window_OnPreviewDragOver"
                      PreviewDragLeave="Window_OnPreviewDragLeave"
                      PreviewDrop="Window_OnPreviewDrop">
                    <Grid.ContextMenu>
                        <ContextMenu x:Name="VideoContextMenu"
                                     Opened="VideoContextMenu_OnOpened"
                                     Closed="VideoContextMenu_OnClosed">
                            <MenuItem x:Name="PlaybackRateMenuItem" Header="再生速度">
                                <MenuItem Header="0.25×" Tag="0.25" IsCheckable="True" Click="PlaybackRateMenuItem_OnClick" />
                                <MenuItem Header="0.5×" Tag="0.5" IsCheckable="True" Click="PlaybackRateMenuItem_OnClick" />
                                <MenuItem Header="1.0×" Tag="1.0" IsCheckable="True" Click="PlaybackRateMenuItem_OnClick" />
                                <MenuItem Header="1.5×" Tag="1.5" IsCheckable="True" Click="PlaybackRateMenuItem_OnClick" />
                                <MenuItem Header="2.0×" Tag="2.0" IsCheckable="True" Click="PlaybackRateMenuItem_OnClick" />
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="SetStartPositionMenuItem"
                                      Header="現在位置を再生開始位置に設定"
                                      Click="SetStartPositionMenuItem_OnClick" />
                            <Separator />
                            <MenuItem x:Name="FullscreenMenuItem"
                                      Header="フルスクリーン"
                                      IsCheckable="True"
                                      Click="FullscreenMenuItem_OnClick" />
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <StackPanel x:Name="EmptyStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="EmptyStateTitleText"
                                   HorizontalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="動画が選択されていません" />
                        <TextBlock x:Name="EmptyStateDescriptionText"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="MP4 または WMV をここにドラッグ＆ドロップできます" />
                    </StackPanel>
                    <Border x:Name="DropTargetOverlay"
                            Margin="24"
                            Background="#E6172635"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="2"
                            CornerRadius="10"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"
                            AutomationProperties.Name="ファイルドロップ先">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="42"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Text="↓" />
                            <TextBlock x:Name="DropTargetText"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Text="動画をドロップして開く" />
                        </StackPanel>
                    </Border>
                </Grid>
            </vlc:VideoView>
        </Grid>

        <Border x:Name="PlaybackControls"
                Grid.Row="2"
                Padding="10,8"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                PreviewKeyDown="Window_OnPreviewKeyDown"
                MouseEnter="PlaybackControls_OnMouseEnter"
                MouseLeave="PlaybackControls_OnMouseLeave">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayPauseButton"
                        Grid.Column="0"
                        Width="42"
                        Height="34"
                        Padding="0"
                        FontSize="16"
                        IsEnabled="False"
                        ToolTip="動画を開くと再生できます"
                        ToolTipService.ShowOnDisabled="True"
                        Click="PlayPauseButton_OnClick"
                        Content="▶"
                        AutomationProperties.Name="再生" />
                <Grid x:Name="SeekArea"
                      Grid.Column="1"
                      Height="22"
                      Margin="12,0,14,0"
                      VerticalAlignment="Center">
                    <Slider x:Name="SeekSlider"
                            Height="22"
                            Minimum="0"
                            Maximum="1"
                            SmallChange="0.01"
                            LargeChange="0.05"
                            IsMoveToPointEnabled="True"
                            IsEnabled="False"
                            ToolTip="動画を開くとシークできます"
                            ToolTipService.ShowOnDisabled="True"
                            ValueChanged="SeekSlider_OnValueChanged"
                            SizeChanged="SeekSlider_OnSizeChanged"
                            AutomationProperties.Name="再生位置" />
                    <Canvas IsHitTestVisible="False">
                        <Grid x:Name="StartPositionMarker"
                              Width="8"
                              Height="20"
                              Visibility="Collapsed"
                              AutomationProperties.Name="登録済み再生開始位置">
                            <Polygon Points="0,0 8,0 4,6" Fill="#FFC857" />
                            <Border Width="2"
                                    Height="13"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#FFC857" />
                        </Grid>
                    </Canvas>
                </Grid>
                <TextBlock x:Name="TimeText"
                           Grid.Column="2"
                           MinWidth="164"
                           VerticalAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="13"
                           Text="--:--:-- / --:--:--"
                           AutomationProperties.Name="再生時刻" />
                <Button x:Name="MuteButton"
                        Grid.Column="3"
                        Width="38"
                        Height="34"
                        Margin="12,0,6,0"
                        Padding="0"
                        FontSize="16"
                        IsEnabled="False"
                        ToolTip="動画を開くとミュートを変更できます"
                        ToolTipService.ShowOnDisabled="True"
                        Click="MuteButton_OnClick"
                        Content="🔊"
                        AutomationProperties.Name="ミュート" />
                <Slider x:Name="VolumeSlider"
                        Grid.Column="4"
                        Height="22"
                        VerticalAlignment="Center"
                        Minimum="0"
                        Maximum="500"
                        Value="100"
                        SmallChange="1"
                        LargeChange="5"
                        TickFrequency="5"
                        IsMoveToPointEnabled="True"
                        IsEnabled="False"
                        ToolTip="動画を開くと音量を変更できます"
                        ToolTipService.ShowOnDisabled="True"
                        ValueChanged="VolumeSlider_OnValueChanged"
                        AutomationProperties.Name="音量" />
                <TextBlock x:Name="VolumeText"
                           Grid.Column="5"
                           MinWidth="43"
                           Margin="7,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="13"
                           Text="100%"
                           AutomationProperties.Name="音量 100%" />
                <Border Grid.Column="6"
                        MinWidth="48"
                        Height="28"
                        Margin="10,0,0,0"
                        Padding="7,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource AppBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        ToolTip="現在の再生速度">
                    <TextBlock x:Name="PlaybackRateText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="13"
                               Text="1.0×"
                               AutomationProperties.Name="現在の再生速度 1.0倍" />
                </Border>
            </Grid>
        </Border>

        <Border x:Name="NotificationBorder"
                Grid.Row="3"
                Margin="12"
                Padding="12"
                Background="#2B2026"
                BorderBrush="#FF6B79"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed"
                AutomationProperties.LiveSetting="Assertive">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="NotificationMessageText"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="NotificationActionText"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        Padding="8,4"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="通知を閉じる"
                        Click="DismissNotificationButton_OnClick"
                        Content="閉じる" />
            </Grid>
        </Border>
    </Grid>
</Window>
