<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>BakuretsuOsakanaKobo.ReleaseValidation</AssemblyName>
    <RootNamespace>BakuretsuOsakanaKobo.ReleaseValidation</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/BakuretsuOsakanaKobo.App/BakuretsuOsakanaKobo.App.csproj" />
    <ProjectReference Include="../../src/BakuretsuOsakanaKobo.Infrastructure/BakuretsuOsakanaKobo.Infrastructure.csproj" />
    <ProjectReference Include="../../src/BakuretsuOsakanaKobo.Playback/BakuretsuOsakanaKobo.Playback.csproj" />
  </ItemGroup>
</Project>
