<Window x:Class="BakuretsuOsakanaKobo.ThumbnailSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="サムネイル設定"
        Icon="Assets/BakuretsuOsakanaKobo.ico"
        Width="420"
        Height="340"
        MinWidth="380"
        MinHeight="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        AutomationProperties.Name="サムネイル設定">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="18" FontWeight="SemiBold" Text="サムネイル生成間隔" />
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="IntervalSlider"
                    VerticalAlignment="Center"
                    Minimum="0.25"
                    Maximum="5.0"
                    TickFrequency="0.25"
                    IsSnapToTickEnabled="True"
                    IsMoveToPointEnabled="True"
                    AutomationProperties.Name="サムネイル生成間隔" />
            <TextBlock x:Name="IntervalValueText"
                       Grid.Column="1"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="14"
                       TextAlignment="Right"
                       Text="1.00%" />
        </Grid>
        <TextBlock Grid.Row="2"
                   Margin="0,18,0,0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="プレビュー幅" />
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="PreviewWidthSlider"
                    VerticalAlignment="Center"
                    Minimum="5"
                    Maximum="30"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    IsMoveToPointEnabled="True"
                    AutomationProperties.Name="サムネイルプレビュー幅" />
            <TextBlock x:Name="PreviewWidthValueText"
                       Grid.Column="1"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="14"
                       TextAlignment="Right"
                       Text="15%" />
        </Grid>
        <TextBlock Grid.Row="4"
                   Margin="0,12,0,0"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   Text="生成間隔は次に開く動画から適用されます。プレビュー幅は現在の動画へすぐに反映され、高さは動画の縦横比に合わせます。" />
        <StackPanel Grid.Row="7" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="CancelButton"
                    Width="88"
                    Margin="0,0,8,0"
                    Style="{StaticResource PlaylistButtonStyle}"
                    IsCancel="True"
                    Content="キャンセル" />
            <Button x:Name="OkButton"
                    Width="88"
                    Style="{StaticResource PlaylistPrimaryButtonStyle}"
                    IsDefault="True"
                    Click="OkButton_OnClick"
                    Content="OK" />
        </StackPanel>
    </Grid>
</Window>
